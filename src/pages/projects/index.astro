---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const config = (await getCollection('siteConfig'))[0].data;
const pages = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects/' },
  ...pages.filter(p => p.data.title !== 'Home').map(p => ({
    label: p.data.navTitle ?? p.data.title,
    href: `/${p.slug}/`,
  })),
];
---
<Base title={`Projects — ${config.firmName}`} description="Selected work" config={config} navItems={navItems}>
  <slot name="head" slot="head">
    <style>
      .list { max-width: 1200px; margin: 0 auto; padding: 4rem 2rem; }
      .list h1 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; margin-bottom: 2.5rem; letter-spacing: -0.03em; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
      .card { display: block; border: 1px solid var(--border); }
      .card img { aspect-ratio: 4/3; object-fit: cover; background: #f0f0f0; }
      .card-meta { padding: 1rem; }
      .card-meta h3 { font-size: 1rem; margin-bottom: 0.25rem; }
      .card-meta span { font-size: 0.8rem; color: var(--text-muted); }
    </style>
  </slot>
  <section class="list">
    <h1>Projects</h1>
    <div class="grid">
      {projects.map(project => (
        <a class="card" href={`/projects/${project.slug}/`}>
          {project.data.coverImage
            ? <img src={project.data.coverImage} alt={project.data.title} loading="lazy" />
            : <img src="" alt={project.data.title} style="width:100%" />}
          <div class="card-meta">
            <h3>{project.data.title}</h3>
            <span>{project.data.year} · {project.data.category}{project.data.location ? ` · ${project.data.location}` : ''}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
